# Local dev defaults match docker-compose.yml — no changes needed to run locally.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=localdevpassword

REDIS_URL=redis://localhost:6379/0

# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model IDs shift fast — verify against https://ai.google.dev/gemini-api/docs/models
# before deploying; these were current as of Jul 2026.
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
EXTRACTION_MODEL=gemini-3.6-flash
CHAT_MODEL=gemini-3.6-flash

# From your Cloudflare Turnstile widget setup
TURNSTILE_SECRET_KEY=

# Shared secret for /api/admin/* endpoints — generate a real random value before deploying
ADMIN_TOKEN=changeme-local-dev-token

MAX_UPLOAD_MB=20
MAX_UPLOAD_PAGES=20

UPLOAD_RATE_LIMIT=5/hour
CHAT_RATE_LIMIT=20/hour

DAILY_COST_BUDGET_USD=5.0
PER_IP_DAILY_COST_BUDGET_USD=0.5

# Comma-separated in production (Cloudflare Pages URL); localhost:5173 for local dev
CORS_ORIGINS=["http://localhost:5173"]

# --- Production-only (Render) ---
# When deployed, NEO4J_URI/PASSWORD come from your AuraDB Free instance's
# downloaded credentials file, and REDIS_URL comes from Upstash's connection
# string (rediss://... — note the TLS "rediss" scheme, not "redis").
