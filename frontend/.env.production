# Production build values. Vite loads this on top of .env whenever mode is
# production, so a `npm run build` run on a machine whose .env points at
# localhost still ships the real backend URL.
#
# Without this, building locally and deploying the result bakes in
# http://localhost:8000 and the live site cannot reach its API at all — the
# same breakage as commit d6b06ce. Cloudflare Pages' own CI build never hits it
# because .env is gitignored and the code falls back to this URL, so the bug
# only ever appears when deploying from a developer machine.
VITE_API_BASE_URL=https://openrag-avea.onrender.com
