# Public Turnstile site key — safe to expose in frontend code, but keeping it
# as an env var makes it easy to swap between dev/prod widgets later.
VITE_TURNSTILE_SITE_KEY=

# Backend API base URL. Leave empty locally (Vite's dev server proxies /api to
# localhost:8000, see vite.config.ts). Set to the real Render URL in production.
VITE_API_BASE_URL=
