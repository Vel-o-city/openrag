# Public Turnstile site key — safe to expose in frontend code, but keeping it
# as an env var makes it easy to swap between dev/prod widgets later.
VITE_TURNSTILE_SITE_KEY=

# Backend API base URL. Point this at your local backend (typically
# http://localhost:8000) for local dev, and at the real Render URL in
# production. The backend's CORS config already allows the Vite dev origin.
# Deliberately NOT proxied through Vite's dev server — its bundled proxy
# strips the Transfer-Encoding header on every response, which breaks the
# streaming /api/chat endpoint (SSE arrives as one truncated chunk).
VITE_API_BASE_URL=http://localhost:8000
